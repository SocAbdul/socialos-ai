AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
API_INTERNAL_URL=http://api:8000/api/v1
