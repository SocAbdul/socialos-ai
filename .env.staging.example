# Non-secret Hetzner + Cloudflare R2 staging template.
# Copy this file to an ignored host-only env file and replace every example/blank value.
# Never commit the populated file.

# Application and immutable release identity
ENVIRONMENT=staging
LOG_LEVEL=INFO
RELEASE_SHA=0000000000000000000000000000000000000000
APP_BASE_URL=https://staging.example.com
WEB_BASE_URL=https://staging.example.com
API_BASE_URL=https://staging.example.com/api/v1
WEB_ORIGINS=https://staging.example.com
TRUSTED_HOSTS=staging.example.com,api,localhost,127.0.0.1

# Versioned container images. Use immutable Git SHA tags; never use latest.
API_IMAGE=registry.example.com/socialos-api
WEB_IMAGE=registry.example.com/socialos-web

# PostgreSQL on the private Docker network (Hetzner host only)
POSTGRES_DB=socialos
POSTGRES_USER=socialos
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis on the private Docker network (Hetzner host only)
REDIS_PASSWORD=
REDIS_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication and application encryption
AUTH_MODE=clerk
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=https://staging.example.com
TOKEN_ENCRYPTION_KEY=

# Cloudflare R2 through the existing S3-compatible adapter
MEDIA_STORAGE_PROVIDER=s3
MEDIA_PUBLIC_BASE_URL=https://media.staging.example.com
S3_MEDIA_BUCKET=
S3_MEDIA_REGION=auto
S3_MEDIA_PUBLIC_BASE_URL=https://media.staging.example.com
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Meta identifiers/secrets. Do not enable until the stable callback is registered manually.
SOCIAL_PROVIDER=meta
SOCIAL_PROVIDER_META_ENABLED=false
SOCIAL_PROVIDER_LINKEDIN_ENABLED=false
SOCIAL_PROVIDER_YOUTUBE_ENABLED=false
SOCIAL_PROVIDER_TIKTOK_ENABLED=false
SOCIAL_PROVIDER_REDDIT_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI=https://staging.example.com/integrations/meta/callback

# Zero-cost local AI adapter for initial staging
AI_PROVIDER=local
AI_MODEL=socialos-local-v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Caddy and operational paths on a pre-provisioned host
CADDY_APP_HOST=staging.example.com
CADDY_ACME_EMAIL=
BACKUP_DIRECTORY=/var/backups/socialos
