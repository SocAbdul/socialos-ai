# Optional for R2, MinIO, B2 or another S3-compatible service.
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SOCIAL_PROVIDER=meta
SOCIAL_PROVIDER_META_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI=https://app.example.com/integrations/meta/callback
AI_PROVIDER=local
AI_MODEL=socialos-local-v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
