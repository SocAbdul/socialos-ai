aws_region = "eu-west-1"

# Must be globally unique.
media_bucket_name = "socialos-ai-staging-media-REPLACE"

media_cors_allowed_origins = [
  "https://staging.socialos.ai",
]

monthly_budget_limit_usd = 25
budget_alert_email       = "founder@example.com"
github_repository        = "SocAbdul/socialos-ai"

# If the AWS account already has a GitHub Actions OIDC provider, set its ARN here.
# Leave null in a fresh account.
existing_github_oidc_provider_arn = null

vpc_cidr = "10.40.0.0/16"
public_subnet_cidrs = [
  "10.40.1.0/24",
  "10.40.2.0/24",
]

# Use full immutable image refs from the Publish Staging Images workflow output.
staging_api_image = "123456789012.dkr.ecr.eu-west-1.amazonaws.com/socialos-staging/api:COMMIT_SHA"
staging_web_image = "123456789012.dkr.ecr.eu-west-1.amazonaws.com/socialos-staging/web:COMMIT_SHA"

staging_desired_count = 1

staging_api_environment = {
  CLERK_AUTHORIZED_PARTIES = "https://staging.socialos.ai"
}

staging_web_environment = {
  NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY = "pk_test_REPLACE"
}

# Map runtime secret env vars to SSM Parameter or Secrets Manager ARNs.
# Do not put secret values in Terraform files.
staging_api_secret_arns = {
  DATABASE_URL         = "arn:aws:ssm:eu-west-1:123456789012:parameter/socialos/staging/DATABASE_URL"
  REDIS_URL            = "arn:aws:ssm:eu-west-1:123456789012:parameter/socialos/staging/REDIS_URL"
  TOKEN_ENCRYPTION_KEY = "arn:aws:ssm:eu-west-1:123456789012:parameter/socialos/staging/TOKEN_ENCRYPTION_KEY"
  CLERK_SECRET_KEY     = "arn:aws:ssm:eu-west-1:123456789012:parameter/socialos/staging/CLERK_SECRET_KEY"
}

staging_web_secret_arns = {}

# Add customer-managed KMS key ARNs here if the SSM parameters/secrets above use
# keys outside the default AWS-managed service keys.
staging_secret_kms_key_arns = []
